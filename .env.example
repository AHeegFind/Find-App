# =============================================================================
# FIND — environment variables
# Copy this file to .env.local and fill in real values.
# Nothing in this app will function against real data until the Supabase
# vars below are set; the AI provider vars are individually optional — any
# missing one falls back to a clearly-logged mock so the rest of the app
# still runs, but real search/vision/image-gen requires the real keys.
# =============================================================================

# --- Supabase (REQUIRED for anything to work) ---------------------------
# Find these in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Settings -> API -> service_role key. NEVER expose this to the client;
# it is only read in server-side API routes (lib/supabase/server.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI: Vision analysis (pick ONE — Anthropic checked first) -----------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys  (also used for text embeddings + moderation below)
OPENAI_API_KEY=

# --- AI: Catalogue image polish (background + lighting + shadow) --------
# https://www.photoroom.com/api — sign up, then Dashboard -> API Keys
# Requires a Plus-tier key (Basic tier only does background removal, not
# lighting/shadow). Falls back to returning the raw photo unmodified if unset.
PHOTOROOM_API_KEY=

# --- AI: Image embeddings for visual similarity search -------------------
# https://replicate.com/account/api-tokens
# Powers image embeddings (CLIP) used for "search by photo" similarity
# matching. Falls back to a mock embedding if unset.
REPLICATE_API_TOKEN=

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Featured slots cron protection ---------------------------------------
# Any random string. Prevents outsiders from triggering the slot
# expiry/activation job. Vercel Cron sends this automatically once set.
CRON_SECRET=
